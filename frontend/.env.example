# Sao thành .env.local (không commit). Có thể sinh từ SSM: uv run scripts/print_env.py frontend --write
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# URL gốc của HTTP API yofina-api, không có dấu / ở cuối
VITE_API_URL=
# Một trong hai: URL đầy đủ của /invocations (có ?qualifier=DEFAULT), hoặc ARN của Runtime (frontend tự dựng URL)
VITE_AGENT_RUNTIME_URL=
VITE_AGENT_RUNTIME_ARN=
# Tùy chọn: email tài khoản demo để nút "Dùng tài khoản demo" điền sẵn (không có mật khẩu)
VITE_DEMO_EMAIL=
# Tùy chọn: 0 để tắt việc nạp lại hội thoại từ GET /conversations/{id} (mặc định bật)
VITE_CONVERSATION_REPLAY=
