    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.5",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "amazon-cognito-identity-js": "6.3.22",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
