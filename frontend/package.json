{
  "name": "yofina-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app Yofina Foresight (Vite + React + TypeScript). Xem README.md.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
